# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# IBR Ops AI Configuration
AI_PROVIDER="openai" # options: "openai", "gemini"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL_ROUTER="gpt-4o-mini"
OPENAI_MODEL_DEFAULT="gpt-4o"
OPENAI_MODEL_ADVANCED="o3-mini"

# Simulation and Write Controls
EXECUTOR_MODE="simulation" # options: "simulation", "live"
ENABLE_WRITE_ACTIONS="false"

# MySQL Canonical Database
DB_HOST="web008.ibrcloud.com.br"
DB_NAME="ibrops_aiops"
DB_USER="ibrops_aiops"
DB_PASS="YOUR_MYSQL_PASSWORD"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
